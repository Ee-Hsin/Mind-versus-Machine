{
  "name": "ai-ramp-games",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/games/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ai-ramp/web",
    "dev:web": "npm run dev --workspace @ai-ramp/web",
    "start": "npm run start --workspace @ai-ramp/web",
    "build": "npm run build --workspace @ai-ramp/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "jiti scripts/check-wordle-rules.ts"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0"
  }
}
