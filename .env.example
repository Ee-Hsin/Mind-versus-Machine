# One OpenRouter key serves every configured model.
OPENROUTER_API_KEY=

# OpenRouter model IDs shown in the launch dialog.
ARENA_MODELS=deepseek/deepseek-v4-flash-0731,openai/gpt-5.6-luna,z-ai/glm-5.2,google/gemini-3.6-flash

# Optional tuning.
# OPENROUTER_MAX_CONCURRENT_REQUESTS=3
# OPENROUTER_MAX_COMPLETION_TOKENS=512
# OPENROUTER_DEEPSEEK_MAX_COMPLETION_TOKENS=4096
# OPENROUTER_OPENAI_MAX_COMPLETION_TOKENS=1024
# OPENROUTER_GLM_MAX_COMPLETION_TOKENS=2048
# OPENROUTER_GEMINI_MAX_COMPLETION_TOKENS=1024
# OPENROUTER_TIMEOUT_MS=180000
# GAME_LIFETIME_MS=7200000
