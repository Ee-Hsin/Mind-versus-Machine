# Models offered in the UI. Only these ids may be selected when creating a game.
ARENA_MODELS=openai:gpt-5.6-luna,anthropic:claude-haiku-4-5,google:gemini-3.1-flash-lite,xai:grok-4-fast-non-reasoning,cohere:command-r7b-12-2024,deepseek:deepseek-v4-flash

# Supabase. These two are the only Supabase values the code reads.
# The secret (service_role) key is server-only — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Not currently used: the browser never talks to Supabase, it only talks to this
# app's API. You would need this once you add Auth for signed-in players.
# SUPABASE_PUBLISHABLE_KEY=

# Model providers. Read by the server only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=

# --- Optional tuning --------------------------------------------------------
# Most concurrent live games this process will hold. A backstop against runaway
# provider spend rather than a memory limit — a game is a few KB.
# ARENA_MAX_CONCURRENT_GAMES=200
# How long an idle game stays resident once its models have settled. Eviction is
# always safe: an unfinished board rebuilds from the database on the next request.
# ARENA_IDLE_EVICTION_MS=300000
# How often to auto-forfeit games past their 24h expiry.
# ARENA_SWEEP_MS=600000
